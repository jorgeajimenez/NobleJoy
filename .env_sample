# ==============================================================================
# ARGON GAME STUDIO (NobleJoy) — Environment & Cloud Switch Configuration
# Copy this file to `.env` in the repo root:
#   cp .env_sample .env
# ==============================================================================

# 1. Google Gemini API Credentials
GEMINI_API_KEY=your_gemini_key
GEMINI_API_KEY_NAME=your_gemini_key_name
PROJECT-NAME=projects/0123456789
PROJECT_NUMBER=0123456789

# 2. Studio Execution Mode Switch (How Gretchen Backend Runs)
#   - auto          : Try Managed Agent -> fall back to Gemini Direct -> fall back to Local Fast (Recommended)
#   - local_fast    : 100% local FastAPI + MuJoCo + procedural PIL skin/WAV/STL/URDF (Zero cloud dependency, instant <50ms)
#   - gemini_direct : Standard Gemini API calls without remote microVM sandbox
#   - managed_agent : Full Cloud Managed Agent Linux microVM sandbox (/workspace extraction)
STUDIO_EXECUTION_MODE=auto
USE_MANAGED_AGENT=true

# 3. Configurable Cloud Model & Agent IDs (Override if endpoints/models change)
GEMINI_MODEL_ID=gemini-4-argon
MANAGED_AGENT_ID=antigravity-preview-09-2026
MANAGED_AGENT_TYPE=antigravity
SKIN_MODEL_ID=gemini-nano-banana-2.1

# 4. Configurable Cloud Endpoint URIs
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
SANDBOX_DOWNLOAD_URI_TEMPLATE=https://generativelanguage.googleapis.com/v1beta/files/environment-{environment_id}:download?alt=media

# 5. FastAPI Gateway URL (Used by Jorge's Rust 3D Client & Local Orchestrator)
#   - Local FastAPI Server : http://127.0.0.1:8000
#   - GCP Cloud Run Server : https://gretchen-studio-gateway-xxxxxxxx-uc.a.run.app
STUDIO_PORT=8000
STUDIO_BACKEND_URL=http://127.0.0.1:8000
